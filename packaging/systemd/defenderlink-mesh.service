[Unit]
Description=DefenderLink Mesh - Decentralized Zero Trust Overlay
Documentation=https://github.com/wpotech/defenderlink-mesh
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
EnvironmentFile=-/etc/defenderlink/defenderlink.conf
ExecStart=/opt/defenderlink/bin/defenderlink-mesh
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=defenderlink

[Install]
WantedBy=multi-user.target
